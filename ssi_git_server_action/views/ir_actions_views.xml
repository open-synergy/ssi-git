<odoo>
<record id="view_server_action_form" model="ir.ui.view">
    <field name="name">ir.actions.server Form - git</field>
    <field name="model">ir.actions.server</field>
    <field name="priority" eval="1" />
    <field name="inherit_id" ref="base.view_server_action_form" />
    <field name="arch" type="xml">
        <xpath expr="//notebook" position="inside">
            <page name="script" string="Scripts">
                <group>
                    <field
                            name='repo_id'
                            attrs="{'invisible': [('state', '!=', 'run_git_script')], 'required': [('state', '=', 'run_git_script')]}"
                        />
                    <field
                            name='branch_id'
                            attrs="{'invisible': [('state', '!=', 'run_git_script')], 'required': [('state', '=', 'run_git_script')]}"
                        />
                    <field
                            name='script_id'
                            attrs="{'invisible': [('state', '!=', 'run_git_script')], 'required': [('state', '=', 'run_git_script')]}"
                        />
                </group>
                <field
                        name='parameter_value_ids'
                        attrs="{'invisible': [('state', '!=', 'run_git_script')]}"
                    >
                    <tree editable="bottom">
                        <field name="parameter_id" />
                        <field name="type" />
                        <field name="value" />
                    </tree>
                </field>
            </page>
        </xpath>
    </field>
</record>
</odoo>
